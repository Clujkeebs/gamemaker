# All optional. Rumpus runs with none of them set, using its offline generator
# and serving published games locally.

# Real generation + conversational editing.
ANTHROPIC_API_KEY=

# Sonnet by default: the preview loop is interactive, and a generation that
# lands in two seconds beats a marginally better one that takes eight.
RUMPUS_MODEL=claude-sonnet-5

# Point the API elsewhere (gateway, proxy, or a mock). Optional.
ANTHROPIC_BASE_URL=

# Publish to a real URL instead of only serving the bundle locally.
NETLIFY_AUTH_TOKEN=

# Root domain for tier-1 subdomains, e.g. rumpus.gg -> catninja.rumpus.gg.
# Needs wildcard DNS and a wildcard certificate pointed at the host.
RUMPUS_ROOT_DOMAIN=

PORT=4173
