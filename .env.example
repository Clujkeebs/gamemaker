# All optional. Rumpus runs with none of them set, using its offline generator
# and serving published games locally.

# ── models ──────────────────────────────────────────────────────────────────
# Either one turns on real generation and conversational editing. With both,
# the editor offers a Fast/Best switch.

# Free tier, no card, fast. This is what "free credits" spend on.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Better results. This is what "paid credits" spend on.
ANTHROPIC_API_KEY=
RUMPUS_MODEL=claude-sonnet-5

# Point either provider elsewhere (gateway, proxy, or a test mock).
GROQ_BASE_URL=
ANTHROPIC_BASE_URL=

# ── credits ─────────────────────────────────────────────────────────────────
RUMPUS_FREE_CREDITS=5      # granted on first visit; fast tier only
RUMPUS_MAX_FREE=60         # ceiling a visitor can reach via promo codes
RUMPUS_IP_CAP=8            # new accounts per IP per day before the grant stops

# Extra promo codes on top of the built-ins (PRODUCTHUNT, SHIPATHON, RUMPUS).
# Format: CODE:credits:maxRedemptions[:expires]
RUMPUS_PROMOS=

# ── payments ────────────────────────────────────────────────────────────────
# Nothing to create in the Stripe dashboard first — prices are sent inline.
# Without STRIPE_WEBHOOK_SECRET the webhook refuses every request, which means
# no credits are ever granted. That is deliberate.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── hosting ─────────────────────────────────────────────────────────────────
NETLIFY_AUTH_TOKEN=        # publish games to their own Netlify sites
RUMPUS_ROOT_DOMAIN=        # e.g. rumpus.gg -> catninja.rumpus.gg
PORT=4173
